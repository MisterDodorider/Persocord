<Window x:Class="Persocord.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Persocord" Height="720" Width="1080"
        MinHeight="440" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bezel}" Foreground="{DynamicResource Ink}">

  <DockPanel>
  <!-- ============ a new version is out ============ -->
  <!-- Only ever here, in the clip list: never over a game or anything else.
       Stays until X (back at the next start) or Update. -->
  <Border x:Name="UpdateBar" DockPanel.Dock="Top" Visibility="Collapsed"
          Background="{DynamicResource PrimaryFill}" Padding="20,10,12,10">
    <Border.Resources>
      <Style x:Key="OnBar" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource OnBrass}"/>
      </Style>
    </Border.Resources>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                 Foreground="{DynamicResource OnBrass}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource OnBrass}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="UpdateText" FontSize="12.5" Foreground="{DynamicResource OnBrass}" Opacity="0.82"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
        <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,7,0,1" Minimum="0" Maximum="1"
                     MaxWidth="380" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="UpdateNotes" Content="What's new" Style="{StaticResource OnBar}" Click="UpdateNotes_Click"
                Margin="0,0,6,0" ToolTip="The release page, with what changed"/>
        <Button x:Name="UpdateButton" Content="Update" Click="UpdateNow_Click" FontWeight="SemiBold"
                Padding="18,0" Margin="0,0,6,0"/>
        <Button x:Name="UpdateClose" Style="{StaticResource OnBar}" Click="UpdateClose_Click" Padding="10,0"
                ToolTip="Hide until Persocord starts again">
          <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ top bar ============ -->
    <Grid Grid.Row="0" Margin="20,16,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Clips" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Button Style="{StaticResource Primary}" Click="Record_Click" Margin="0,0,8,0"
                ToolTip="Pick an area of the screen and start recording">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#FFB8322A" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Record area" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Content="Record GIF" Click="RecordGif_Click" Padding="12,0,8,0"/>
        <Button x:Name="GifOptionsButton" Click="GifOptions_Click" Margin="2,0,0,0" Padding="7,0"
                ToolTip="GIF length, frame rate and width">
          <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
        </Button>
        <!-- The replay's switch: remembered across restarts. -->
        <Button x:Name="ReplayToggle" Margin="8,0,0,0" Click="ReplayToggle_Click">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ReplayDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="ReplayText" Text="Replay" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- search -->
      <Grid Grid.Column="1" Margin="18,0,18,0" MaxWidth="460" HorizontalAlignment="Stretch">
        <TextBox x:Name="Search" VerticalContentAlignment="Center" Padding="34,8,10,8"
                 TextChanged="Search_Changed" ToolTip="Filter by title, app or note"/>
        <Path Data="M 6 0 A 6 6 0 1 1 5.99 0 Z M 10.5 10.5 L 14 14" Stroke="{DynamicResource Faint}"
              StrokeThickness="1.6" StrokeEndLineCap="Round" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock x:Name="SearchHint" Text="Search clips" IsHitTestVisible="False"
                   VerticalAlignment="Center" Margin="37,0,0,0" Foreground="{DynamicResource Faint}"/>
      </Grid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="JoinButton" Content="Join selected" Click="Join_Click" Margin="0,0,8,0"
                Visibility="Collapsed"
                ToolTip="Join the selected clips into one, oldest first"/>
        <Button Style="{StaticResource Ghost}" Content="Open folder" Click="OpenFolder_Click" Margin="0,0,4,0"/>
        <Button Style="{StaticResource Ghost}" Content="Settings" Click="Settings_Click"/>
      </StackPanel>
    </Grid>

    <!-- ============ folder problem banner ============ -->
    <!-- ============ where you are, filters and sort ============ -->
    <StackPanel Grid.Row="1" Margin="20,0,20,6">
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="+ New folder"
                Click="NewFolder_Click" ToolTip="Make a folder here"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="+ Gallery preview"
                Click="AddPreview_Click"
                ToolTip="Show another folder's videos here (a game's own clip folder, say) to watch and manage them in Persocord. Nothing is moved or copied."/>
        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <WrapPanel x:Name="FilterBar" Grid.Column="0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
          <TextBlock Text="Sort" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="SortBox" Width="150" SelectionChanged="Sort_Changed"/>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Grid.Row="2" x:Name="Alert" Visibility="Collapsed" Margin="20,0,20,10"
            Background="{DynamicResource BrickSoft}" CornerRadius="10" Padding="16,11,12,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="AlertText" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Look for it" Click="Locate_Click" Margin="12,0,6,0"/>
          <Button Content="Choose folder" Click="ChooseFolder_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ clips ============ -->
    <DockPanel Grid.Row="3">
    <!-- Right after starting: what's still being got ready (previews can be slow until it's done). -->
    <Border x:Name="SetupBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="20,0,20,8"
            Background="{DynamicResource Panel}" CornerRadius="10" Padding="14,9,14,10">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="SetupCount" DockPanel.Dock="Right" Style="{StaticResource Meta}" Margin="12,0,0,0"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="SetupText" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <ProgressBar x:Name="SetupProgress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"/>
      </StackPanel>
    </Border>
    <!-- A level with folders shows them filling the whole area (with an
         "Unsorted" tile for the clips that aren't in any); the clips show
         once a folder (or Unsorted) is opened. -->
    <ScrollViewer x:Name="FolderScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Margin="20,4,14,6" Visibility="Collapsed">
      <WrapPanel x:Name="FolderTiles" VerticalAlignment="Top"/>
    </ScrollViewer>
    <ListBox x:Name="List" Padding="14,0,14,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             PreviewMouseLeftButtonDown="List_MouseDown"
             PreviewMouseMove="List_MouseMove"
             MouseDoubleClick="List_DoubleClick"
             PreviewMouseRightButtonUp="List_RightClick"
             SelectionMode="Extended"
             SelectionChanged="List_SelectionChanged">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="{DynamicResource CardMargin}"/>
          <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
          <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <!-- Card look (fill, edge, lift, stripe) comes from Customization. -->
                <Border x:Name="card" Background="{DynamicResource CardFill}" CornerRadius="{DynamicResource RadiusCard}"
                        BorderThickness="{DynamicResource CardEdgeThickness}" BorderBrush="{DynamicResource CardEdge}">
                  <Grid>
                    <Border Background="{DynamicResource CardSheen}" CornerRadius="{DynamicResource RadiusCard}" IsHitTestVisible="False"/>
                    <Border x:Name="stripe" Width="3" HorizontalAlignment="Left" Margin="0,10,0,10" CornerRadius="1.5"
                            Background="{DynamicResource Brass}" Visibility="Collapsed"/>
                    <ContentPresenter/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHoverFill}"/>
                    <Setter Property="RenderTransform" Value="{DynamicResource CardHoverTransform}"/>
                    <Setter TargetName="card" Property="Effect" Value="{DynamicResource CardHoverEffect}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardSelectedFill}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BrassLineHover}"/>
                    <Setter TargetName="stripe" Property="Visibility" Value="{DynamicResource ShowStripe}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>

      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="{DynamicResource CardPadding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- thumbnail, with the length on it; drag the card into Discord -->
            <Border Grid.Column="0" Width="{DynamicResource ThumbWidth}" Height="{DynamicResource ThumbHeight}"
                    CornerRadius="{DynamicResource RadiusThumb}" Margin="0,0,16,0"
                    Background="{DynamicResource Field}"
                    MouseEnter="Thumb_MouseEnter" MouseLeave="Thumb_MouseLeave"
                    PreviewMouseLeftButtonDown="Thumb_Down" MouseLeftButtonUp="Thumb_Click" Cursor="Hand">
              <Grid>
                <Border CornerRadius="{DynamicResource RadiusThumb}">
                  <Border.Background>
                    <ImageBrush RenderOptions.BitmapScalingMode="HighQuality" ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                  </Border.Background>
                </Border>
                <TextBlock Text="{Binding Kind}" Style="{StaticResource Meta}" Foreground="{DynamicResource Faint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoThumb, Converter={StaticResource BoolVis}}"/>
                <Border Background="#CC0D0F12" CornerRadius="5" Padding="6,1,6,2" Margin="0,0,6,6"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{DynamicResource ShowDuration}">
                  <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold"
                             Foreground="#FFE8EAED"/>
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <!-- The name: click to rename it right here. -->
              <Grid HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Cursor="IBeam" ToolTip="Click to rename" Background="Transparent"
                           MouseEnter="Title_MouseEnter" MouseLeave="Title_MouseLeave" PreviewMouseLeftButtonDown="Title_Click"/>
                <TextBox Visibility="Collapsed" MinWidth="260" FontSize="13.5"
                         KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus"/>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Visibility="{DynamicResource ShowSize}">
                  <TextBlock Style="{StaticResource Meta}" Text="{Binding SizeText}"
                             Foreground="{Binding SizeBrush}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="  ·  " Foreground="{DynamicResource Faint}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Meta}" Visibility="{DynamicResource ShowDate}"
                           Text="{Binding Created, StringFormat={}{0:d MMM yyyy, HH:mm}}"/>
                <TextBlock Style="{StaticResource Meta}" Margin="10,0,0,0" Foreground="{DynamicResource AccentText}"
                           Text="{Binding FolderLabel}" Visibility="{DynamicResource ShowFolder}"/>

                <!-- small tags -->
                <Border Background="{DynamicResource BrassSofter}" CornerRadius="4" Padding="6,0,6,1" Margin="10,0,0,0"
                        Visibility="{Binding Favourite, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="Kept" FontSize="11" Foreground="{DynamicResource AccentText}"/>
                </Border>
                <Border Background="{DynamicResource BrickSoft}" CornerRadius="4" Padding="6,0,6,1" Margin="6,0,0,0"
                        Visibility="{Binding Private, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="Private" FontSize="11" Foreground="{DynamicResource Brick}"/>
                </Border>
                <Border Background="{DynamicResource Hover}" CornerRadius="4" Padding="6,0,6,1" Margin="6,0,0,0"
                        Visibility="{Binding Note, Converter={StaticResource NullVis}}">
                  <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                </Border>
                <!-- Tags: click to add or remove. -->
                <ItemsControl ItemsSource="{Binding Tags}" Cursor="Hand" ToolTip="Click to add or remove tags"
                              Background="Transparent" PreviewMouseLeftButtonDown="TagsArea_Click"
                              Visibility="{DynamicResource ShowTags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource BrassSofter}" CornerRadius="4" Padding="6,0,6,1" Margin="6,0,0,0">
                        <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" Foreground="{DynamicResource AccentText}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border CornerRadius="4" Padding="6,0,6,1" Margin="6,0,0,0" Cursor="Hand" Background="Transparent"
                        BorderThickness="1" BorderBrush="{DynamicResource Line}" Visibility="{DynamicResource ShowTags}"
                        ToolTip="Add or remove tags" PreviewMouseLeftButtonDown="TagsArea_Click">
                  <TextBlock Text="+ tag" FontSize="11" Foreground="{DynamicResource Faint}"/>
                </Border>
              </StackPanel>

              <!-- the share link as a pill (click to copy), or upload progress -->
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                          Visibility="{Binding ShowLinkLine, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding UploadStatus}" FontSize="12" Foreground="{DynamicResource AccentText}"
                           Visibility="{Binding IsUploading, Converter={StaticResource BoolVis}}"/>
                <Button Style="{StaticResource LinkPill}" Tag="{Binding}" Click="CopyLink_Click"
                        ToolTip="Click to copy the link"
                        Visibility="{Binding HasLink, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding LinkText}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Faint}"/>
                    <TextBlock Text="{Binding LinkTimeLeft}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="{Binding CopiedFlash}" Margin="8,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Ghost}" Content="✕" Tag="{Binding}" Click="KillLink_Click"
                        Padding="8,3,8,3" Margin="4,0,0,0" FontSize="11" ToolTip="Kill link (take it down now)"
                        Visibility="{Binding CanKill, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </StackPanel>

            <!-- main actions; everything else is in the ⋯ menu (or right-click) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Compress" Tag="{Binding}" Click="Compress_Click" Margin="0,0,6,0"
                      Visibility="{Binding CanCompress, Converter={StaticResource BoolVis}}"
                      ToolTip="Compress Size: make a copy that fits any size you pick"/>
              <Button Content="Copy" Tag="{Binding}" Click="Copy_Click" Margin="0,0,6,0"
                      ToolTip="Copy the file, then Ctrl+V in Discord"/>
              <Button Content="Upload" Tag="{Binding}" Click="Upload_Click" Margin="0,0,1,0"
                      IsEnabled="{Binding CanUpload}"
                      ToolTip="Upload with your default link settings and copy the link"/>
              <Button Content="▾" Tag="{Binding}" Click="UploadMenu_Click" Margin="0,0,6,0"
                      Padding="8,7,8,7" IsEnabled="{Binding CanUpload}"
                      ToolTip="Choose how long the link lasts and where it's hosted"/>
              <Button Content="Edit" Tag="{Binding}" Click="Edit_Click" Margin="0,0,6,0"
                      IsEnabled="{Binding CanEdit}"
                      ToolTip="Trim, cut, crop, change speed or sound"/>
              <Button Style="{StaticResource Ghost}" Content="⋯" Tag="{Binding}" Click="More_Click"
                      FontSize="16" Padding="10,3,10,6" ToolTip="More"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>

    <!-- ============ empty ============ -->
    <StackPanel Grid.Row="3" x:Name="EmptyState" VerticalAlignment="Center"
                HorizontalAlignment="Center" Visibility="Collapsed">
      <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Panel}" HorizontalAlignment="Center">
        <Ellipse Width="18" Height="18" Fill="#FFB8322A"/>
      </Border>
      <TextBlock Text="No clips yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                 Margin="0,16,0,0" FontFamily="{DynamicResource Display}"/>
      <TextBlock x:Name="EmptyHint" Style="{StaticResource Meta}" Margin="0,6,0,0"
                 HorizontalAlignment="Center"/>
      <Button Style="{StaticResource Primary}" Content="Record an area" Click="Record_Click"
              HorizontalAlignment="Center" Margin="0,18,0,0"/>
    </StackPanel>

    <!-- ============ footer: status and space used ============ -->
    <Border Grid.Row="4" Background="{DynamicResource Panel}" Padding="20,10,20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" x:Name="Status" Style="{StaticResource Meta}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="DiskText" Style="{StaticResource Meta}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <!-- track, fill, and the tick where the warning kicks in -->
          <Grid Width="160" Height="6" VerticalAlignment="Center">
            <Border Background="{DynamicResource Hover}" CornerRadius="3"/>
            <Rectangle x:Name="DiskFill" HorizontalAlignment="Left" Width="0"
                       RadiusX="3" RadiusY="3" Fill="{DynamicResource Brass}"/>
            <Rectangle x:Name="DiskMark" HorizontalAlignment="Left" Width="2"
                       Fill="{DynamicResource Brick}" Margin="0" ToolTip="Warning level"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <!-- The player, over the whole window while a clip plays (Back returns). -->
    <ContentControl x:Name="PlayerHost" Grid.RowSpan="5" Visibility="Collapsed" Panel.ZIndex="50"/>
  </Grid>
  </DockPanel>
</Window>
