<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Persocord.Views">

  <v:BoolToVisibilityConverter   x:Key="BoolVis"/>
  <v:NullToVisibilityConverter   x:Key="NullVis"/>

  <!-- ================================================================
       Graphite. Near-black surfaces in a few close steps, so panels read
       as gently raised rather than outlined. Gold is the one accent; red
       only ever means recording or danger.
       ================================================================ -->
  <Color x:Key="BezelColor">#FF121417</Color>   <!-- window background -->
  <Color x:Key="PanelColor">#FF191C20</Color>   <!-- cards, bars -->
  <Color x:Key="RaisedColor">#FF20242A</Color>  <!-- menus, popups -->
  <Color x:Key="FieldColor">#FF0D0F12</Color>   <!-- text boxes, tracks -->
  <Color x:Key="LineColor">#FF262A31</Color>
  <Color x:Key="InkColor">#FFE8EAED</Color>
  <Color x:Key="MutedColor">#FF8A909A</Color>
  <Color x:Key="FaintColor">#FF5A6069</Color>
  <Color x:Key="BrassColor">#FFD6B06A</Color>
  <Color x:Key="BrickColor">#FFE0594D</Color>

  <SolidColorBrush x:Key="Bezel"  Color="{StaticResource BezelColor}"/>
  <SolidColorBrush x:Key="Panel"  Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}"/>
  <SolidColorBrush x:Key="Field"  Color="{StaticResource FieldColor}"/>
  <SolidColorBrush x:Key="Line"   Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="Ink"    Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="Muted"  Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="Faint"  Color="{StaticResource FaintColor}"/>
  <SolidColorBrush x:Key="Brass"  Color="{StaticResource BrassColor}"/>
  <SolidColorBrush x:Key="Brick"  Color="{StaticResource BrickColor}"/>
  <SolidColorBrush x:Key="Hover"  Color="#FF23272E"/>
  <SolidColorBrush x:Key="Pressed" Color="#FF2B3038"/>
  <SolidColorBrush x:Key="ButtonFill" Color="#FF1E2126"/>
  <SolidColorBrush x:Key="LineStrong" Color="#FF363B44"/>
  <SolidColorBrush x:Key="CardHover" Color="#FF1D2025"/>
  <SolidColorBrush x:Key="CardSelected" Color="#FF1F2228"/>
  <SolidColorBrush x:Key="BrassSoft" Color="#1FD6B06A"/>
  <SolidColorBrush x:Key="BrassSofter" Color="#12D6B06A"/>
  <SolidColorBrush x:Key="BrassPress" Color="#2ED6B06A"/>
  <SolidColorBrush x:Key="BrassLine" Color="#33D6B06A"/>
  <SolidColorBrush x:Key="BrassLineHover" Color="#66D6B06A"/>
  <SolidColorBrush x:Key="BrassHover" Color="#FFE3C184"/>
  <SolidColorBrush x:Key="BrassPressed" Color="#FFC29C58"/>
  <SolidColorBrush x:Key="OnBrass" Color="#FF141210"/>
  <SolidColorBrush x:Key="BrickSoft" Color="#1FE0594D"/>
  <!-- Set by the look engine (ThemeApplier); these are the dark defaults. -->
  <SolidColorBrush x:Key="Body" Color="#FFC9CDD3"/>
  <SolidColorBrush x:Key="ButtonInk" Color="#FFC9CDD3"/>
  <SolidColorBrush x:Key="Track" Color="#FF2A2F37"/>
  <SolidColorBrush x:Key="ScrollThumbFill" Color="#FF2E333B"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF454B55"/>
  <SolidColorBrush x:Key="ScrollThumbPressed" Color="#FF5A616C"/>
  <SolidColorBrush x:Key="CheckEdge" Color="#FF3A3F47"/>
  <SolidColorBrush x:Key="CheckEdgeHover" Color="#FF565C66"/>
  <SolidColorBrush x:Key="MenuEdge" Color="#FF30353D"/>
  <SolidColorBrush x:Key="PrimaryFill" Color="#FFD6B06A"/>
  <SolidColorBrush x:Key="PrimaryHover" Color="#FFE3C184"/>
  <SolidColorBrush x:Key="PrimaryPressed" Color="#FFC29C58"/>
  <SolidColorBrush x:Key="ButtonEdge" Color="Transparent"/>
  <Thickness x:Key="ButtonEdgeThickness">0</Thickness>
  <Thickness x:Key="ButtonPadding">13,7,13,7</Thickness>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
  <CornerRadius x:Key="RadiusMenu">9</CornerRadius>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusThumb">7</CornerRadius>
  <CornerRadius x:Key="RadiusPill">11</CornerRadius>

  <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Bezel}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <!-- No Foreground here on purpose: an implicit TextBlock style overrides
       inherited colour, which would flatten every button and label to one
       colour. Windows set Ink at the root and text inherits it. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
  </Style>

  <!-- Secondary detail: sizes, dates, hints. -->
  <Style x:Key="Meta" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}"/>
  </Style>

  <Style x:Key="SectionHead" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontHead}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,22,0,10"/>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ================================================================
       Buttons. The plain button is quiet: a soft fill that brightens on
       hover. Primary is solid gold, for the one main action in a place.
       ================================================================ -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ButtonInk}"/>
    <Setter Property="Background" Value="{DynamicResource ButtonFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ButtonEdgeThickness}"/>
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="{DynamicResource RadiusControl}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Pressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brass}"/>
              <Setter TargetName="b" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource OnBrass}"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="{DynamicResource RadiusControl}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brick}"/>
    <Setter Property="Background" Value="{DynamicResource BrickSoft}"/>
  </Style>

  <!-- Borderless, for icon-ish actions that should recede until hovered. -->
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>

  <!-- The share-link pill: gold-tinted, clearly clickable. -->
  <Style x:Key="LinkPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource BrassSofter}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="Padding" Value="10,4,10,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="{DynamicResource RadiusPill}" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BrassLine}" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BrassSoft}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrassLineHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BrassPress}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Text fields
       ================================================================ -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7,10,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brass}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Brass}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" CornerRadius="{DynamicResource RadiusControl}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <!-- No Margin from Padding here: WPF applies a text box's Padding
                 inside the content host itself, so adding it again doubled
                 it and pushed the text away from where it should start. -->
            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brass}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,6,9,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brass}"/>
  </Style>

  <!-- ================================================================
       Dropdown. The stock ComboBox, TabItem and CheckBox templates on
       Windows 10 and 11 ignore their colours, so all three are replaced.
       ================================================================ -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="bd" Background="{DynamicResource Field}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}">
      <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,12,0" Data="M 0 0 L 4.5 4.5 L 9 0"
            Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Ink}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brass}"/>
        <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Brass}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter IsHitTestVisible="False" Margin="11,0,32,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                      BorderThickness="1" CornerRadius="{DynamicResource RadiusMenu}" Margin="0,4,0,0" Padding="4"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Padding" Value="9,6,9,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            </Trigger>
            <!-- Unavailable choices look it: faded, no hand cursor. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
              <Setter Property="Opacity" Value="0.6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="18" Height="18" CornerRadius="{DynamicResource RadiusSmall}" VerticalAlignment="Top" Margin="0,1,0,0"
                    Background="{DynamicResource Field}" BorderBrush="{DynamicResource CheckEdge}" BorderThickness="1.5">
              <Path x:Name="tick" Data="M 3.5 9 L 7.5 12.5 L 14 5" Stroke="{DynamicResource OnBrass}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckEdgeHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brass}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brass}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Tabs, laid out as a sidebar: a long row of tabs across the top
       wraps and crowds; a list down the side reads like modern settings.
       ================================================================ -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource Bezel}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="184"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Panel}">
              <StackPanel IsItemsHost="True" Margin="10,14,10,10" KeyboardNavigation.TabNavigation="Once"/>
            </Border>
            <Border Grid.Column="1" Background="{TemplateBinding Background}">
              <ContentPresenter ContentSource="SelectedContent" Margin="8,0,0,0"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,8,12,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Margin="0,0,0,2">
            <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource Brass}" Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
              <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Scrollbars: thin, rounded, no arrows. They sit out of the way until
       needed.
       ================================================================ -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" CornerRadius="3" Background="{DynamicResource ScrollThumbFill}" Margin="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}"/>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================
       Slider: a slim track filled in gold up to a round handle.
       ================================================================ -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent">
            <Border Height="{DynamicResource SliderHeight}" CornerRadius="2" Background="{DynamicResource Brass}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderRest" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent">
            <Border Height="{DynamicResource SliderHeight}" CornerRadius="2" Background="{DynamicResource Track}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="knob" Width="15" Height="15" Fill="{DynamicResource Ink}"
                             Stroke="{DynamicResource Brass}" StrokeThickness="3"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="knob" Property="Width" Value="17"/>
                        <Setter TargetName="knob" Property="Height" Value="17"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Track}"/>
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Brass}"
                    HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Menus and tooltips. Without these they appear in Windows' light
       default look, a white flash in an otherwise dark app.
       ================================================================ -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMenu}" Padding="5" MinWidth="190">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="10,7,22,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="check" Text="✓" Foreground="{DynamicResource AccentText}"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0"
                         Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,5,8,5" Background="{DynamicResource Line}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Sans}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMenu}" Padding="10,6,10,7" MaxWidth="380">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Odds and ends
       ================================================================ -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>

  <!-- A fold-out section: a heading with a chevron, options hidden until opened. -->
  <Style x:Key="Fold" TargetType="Expander">
    <Setter Property="Margin" Value="0,14,0,0"/>
    <!-- Without this, Windows' own Expander colour (black) is what the content inherits. -->
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="IsExpanded" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Content="{TemplateBinding Header}" Focusable="False" Cursor="Hand"
                          HorizontalAlignment="Left"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="6,5,10,5" Margin="-6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <Path x:Name="chev" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                            Width="6" Height="8" VerticalAlignment="Center" Margin="2,0,10,0"
                            RenderTransformOrigin="0.5,0.5"/>
                      <ContentPresenter x:Name="txt" VerticalAlignment="Center" RecognizesAccessKey="False"
                                        TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"
                                        TextElement.Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                      <Setter TargetName="txt" Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="chev" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                      </Setter>
                      <Setter TargetName="chev" Property="Stroke" Value="{DynamicResource Brass}"/>
                      <Setter TargetName="txt" Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="body" Visibility="Collapsed" Margin="16,8,0,4"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="body" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Margin="3,1,3,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrassSoft}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Line}"/>
    <Setter Property="Margin" Value="0,12,0,12"/>
  </Style>

  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="0,0,0,5"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
