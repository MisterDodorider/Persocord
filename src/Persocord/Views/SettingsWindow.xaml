<Window x:Class="Persocord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Persocord.Views"
        Title="Persocord settings" Height="700" Width="860"
        MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bezel}" Foreground="{DynamicResource Ink}">

  <Window.Resources>
    <!-- A choice and what picking it would change. The change shows in the
         open list only (inside a ComboBoxItem), never in the closed box. -->
    <DataTemplate x:Key="CostOptionTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Label}"/>
        <TextBlock x:Name="Diff" Text="{Binding Delta}" Margin="14,0,0,0" FontSize="12"
                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
          <Setter TargetName="Diff" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Delta}" Value="">
          <Setter TargetName="Diff" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Search: jumps to any setting (Enter for the next match). -->
    <Grid Grid.Row="0" Margin="16,10,16,6">
      <!-- The same search box as the clip list: the icon stays, only the hint text gives way. -->
      <TextBox x:Name="SettingsSearch" Width="360" HorizontalAlignment="Left" VerticalContentAlignment="Center"
               Padding="34,8,10,8" TextChanged="SettingsSearch_Changed" KeyDown="SettingsSearch_KeyDown"/>
      <Path Data="M 6 0 A 6 6 0 1 1 5.99 0 Z M 10.5 10.5 L 14 14" Stroke="{DynamicResource Faint}"
            StrokeThickness="1.6" StrokeEndLineCap="Round" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Text="Search settings"
                 Margin="37,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Faint}"/>
      <TextBlock x:Name="SearchResult" HorizontalAlignment="Left" Margin="376,0,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
    </Grid>

    <TabControl x:Name="Tabs" Grid.Row="1" Background="{DynamicResource Bezel}">

      <!-- ============ general ============ -->
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="16,12,16,12" Margin="0,0,0,18" HorizontalAlignment="Left">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Re-setup" Click="RunSetup_Click" Margin="16,0,0,0" VerticalAlignment="Center"
                        Tag="setup re-setup onboarding tutorial welcome first run wizard"/>
                <StackPanel MaxWidth="440">
                  <TextBlock Text="First-time setup" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="Walk through the important settings again. It shows what you have now; only what you change there changes."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <CheckBox x:Name="ChkStartup" Margin="0,0,0,0" Content="Start Persocord when Windows starts" Tag="startup boot login sign in launch"/>

            <TextBlock Style="{StaticResource SectionHead}" Text="Notifications"/>
            <CheckBox x:Name="ChkToasts" Content="Use Persocord's notifications instead of Windows'"/>
            <Expander Style="{StaticResource Fold}" Header="Persocord's notifications">
              <StackPanel>
                <Label Content="Where they appear" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbToastPos" Width="220" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Bottom right"/>
                  <ComboBoxItem Content="Bottom centre"/>
                  <ComboBoxItem Content="Bottom left"/>
                  <ComboBoxItem Content="Top right"/>
                  <ComboBoxItem Content="Top centre"/>
                  <ComboBoxItem Content="Top left"/>
                </ComboBox>
                <Label Content="Clicking a clip notification" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbToastClick" Width="260" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Shows it in the clip list"/>
                  <ComboBoxItem Content="Opens it in the editor"/>
                  <ComboBoxItem Content="Plays it"/>
                  <ComboBoxItem Content="Just closes the notification"/>
                </ComboBox>
                <Label Content="Show for (seconds)" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="TxtToastSeconds" Width="70"/>
                  <Button Style="{StaticResource Ghost}" Content="Show a test" Margin="10,0,0,0" Click="TestToast_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,18"
                           Text="They never take focus from a game."/>
              </StackPanel>
            </Expander>


          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ customization ============ -->
      <TabItem Header="Customization">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <ContentControl x:Name="CustomHost" MaxWidth="760" HorizontalAlignment="Left"/>
        </ScrollViewer>
      </TabItem>


      <!-- ============ library ============ -->
      <TabItem Header="Library">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Label Content="Clips are saved here"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="TxtFolder" Width="400"/>
              <Button Content="Change" Click="Browse_Click" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Changing it asks whether your clips move along."/>

            <TextBlock Style="{StaticResource SectionHead}" Text="Folders"/>
            <CheckBox x:Name="ChkAutoSort" Content="Sort clips into a folder per game or app"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="Folders are made automatically. Desktop clips go in Desktop."/>

            <Expander Style="{StaticResource Fold}" Header="Storage and log">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                           Text="A reminder only. Nothing is ever deleted automatically."/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="TxtDiskPercent" Width="70"/>
                  <TextBlock Text="% of the drive" VerticalAlignment="Center"
                             Margin="10,0,0,0" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                </StackPanel>
                <TextBlock x:Name="CapExplain" Style="{StaticResource Meta}" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>


                <CheckBox x:Name="ChkRecycle" Margin="0,14,0,0"
                          Content="Clips you delete go to the Recycle Bin"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                           Text="Off means deleting is permanent."/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Content="Check usage now" Click="CheckDisk_Click"/>
                  <Button Content="Open folder" Click="OpenFolder_Click" Margin="8,0,0,0"/>
                  <Button Content="Open log file" Click="OpenLog_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DiskNow" Style="{StaticResource Meta}" TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ sharing ============ -->
      <TabItem Header="Sharing">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <CheckBox x:Name="ChkCopyOnFinish"
                      Content="Copy recordings and GIFs to the clipboard when they finish"/>
            <CheckBox x:Name="ChkCopyReplay" Margin="0,8,0,0"
                      Content="Copy replays to the clipboard when they're saved"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="Paste straight into Discord with Ctrl+V."/>

            <Expander Style="{StaticResource Fold}" Header="Compress Size">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                           Text="Quick sizes offered by the Compress button."/>
                <Label Content="Quick sizes in MB (separated by commas)"/>
                <TextBox x:Name="TxtCompressPresets" Width="320" HorizontalAlignment="Left"/>
                <CheckBox x:Name="ChkKeepOriginal" Margin="0,14,0,0"
                          Content="Keep the full-quality file as well"/>
                <CheckBox x:Name="ChkShrinkGpu" Margin="0,14,0,0"
                          Content="Compress on the graphics card"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                           Text="Much faster. The CPU is slightly sharper at very small sizes."/>

              </StackPanel>
            </Expander>


          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ links ============ -->
      <TabItem Header="Links">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionHead}" Margin="0,0,0,4" Text="One-click Upload"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Used by Upload. The arrow next to it picks different options for one clip."/>
            <ContentControl x:Name="LinkDefaultsHost"/>

            <CheckBox x:Name="ChkUploadAfter" Margin="0,18,0,0"
                      Content="Upload every recording automatically with these settings"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="Private clips are never uploaded."/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ sounds ============ -->
      <TabItem Header="Sounds">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <CheckBox x:Name="ChkCues" Content="Play sound cues"/>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Volume" VerticalAlignment="Center"/>
              <Slider x:Name="SldCueVolume" Grid.Column="1" Minimum="0" Maximum="100"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5"/>
              <TextBlock x:Name="CueVolumeText" Grid.Column="2" Style="{StaticResource Meta}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionHead}" Text="Cues"/>
            <StackPanel x:Name="CueRows"/>

            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Cues never end up in your recordings."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ audio ============ -->
      <TabItem Header="Audio">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Label Content="Record"/>
            <ComboBox x:Name="CmbAudio">
              <ComboBoxItem Content="No audio"/>
              <ComboBoxItem Content="PC audio only"/>
              <ComboBoxItem Content="Microphone only"/>
              <ComboBoxItem Content="PC audio and microphone"/>
            </ComboBox>

            <Label Content="PC audio comes from" Margin="0,14,0,0"/>
            <ComboBox x:Name="CmbSysDevice"/>
            <Grid Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center"
                         Foreground="{DynamicResource Muted}" FontSize="12.5"/>
              <Slider Grid.Column="1" x:Name="SldSysGain" Minimum="0" Maximum="200"
                      Margin="10,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" x:Name="SysGainText" Style="{StaticResource Meta}"
                         VerticalAlignment="Center" Width="44"/>
            </Grid>

            <Label Content="Microphone" Margin="0,14,0,0"/>
            <ComboBox x:Name="CmbMicDevice"/>
            <TextBlock Style="{StaticResource Meta}" Margin="0,10,0,4" Text="Level (talk to test)"/>
            <Grid x:Name="MicMeter" Height="10" Width="320" HorizontalAlignment="Left" Background="#26FFFFFF"
                  Tag="mic level meter test volume">
              <Rectangle x:Name="MicMeterBar" HorizontalAlignment="Left" Width="0" Fill="{DynamicResource Brass}"/>
              <Rectangle x:Name="MicGateMarker" HorizontalAlignment="Left" Width="2" Fill="#E6FFFFFF" Margin="0,-3,0,-3"/>
            </Grid>
            <Grid Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center"
                         Foreground="{DynamicResource Muted}" FontSize="12.5"/>
              <Slider Grid.Column="1" x:Name="SldMicGain" Minimum="0" Maximum="200"
                      Margin="10,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" x:Name="MicGainText" Style="{StaticResource Meta}"
                         VerticalAlignment="Center" Width="44"/>
            </Grid>
            <TextBlock x:Name="MicHotNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource Brick}"
                       Text="Your mic is reaching its maximum. A sensitive mic can max out on breathing or talking close to it: turn its volume down until the bar stays short of the end, or switch on Limit loudness below."/>
            <CheckBox x:Name="ChkMicGate" Margin="0,10,0,0" Content="Silence the mic below the sensitivity line"
                      Tag="noise gate sensitivity threshold static background"/>
            <Grid Margin="22,4,0,0" Width="298" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Slider x:Name="SldMicGate" Minimum="-70" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True"
                      Tag="sensitivity mic gate threshold"/>
              <TextBlock Grid.Column="1" x:Name="TxtMicGate" Style="{StaticResource Meta}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <Label Content="AI noise suppression" Margin="0,10,0,0"/>
            <ComboBox x:Name="CmbMicSuppression" Width="180" HorizontalAlignment="Left"
                      Tag="noise suppression ai rnnoise krisp fan hum keyboard background denoise">
              <ComboBoxItem Content="Off"/>
              <ComboBoxItem Content="Low"/>
              <ComboBoxItem Content="Medium"/>
              <ComboBoxItem Content="High"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Removes fans, hum and keyboard noise from your voice in recordings and replays."/>
            <TextBlock x:Name="MicSuppressionCost" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource AccentText}"/>
            <CheckBox x:Name="ChkMicLimiter" Margin="0,10,0,0" Content="Limit loudness (tames shouting)"
                      Tag="limiter loud mic shouting peaks compressor"/>
            <Grid Margin="22,4,0,0" Width="298" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Slider x:Name="SldMicLimiter" Minimum="-24" Maximum="-3" TickFrequency="1" IsSnapToTickEnabled="True"
                      Tag="loudness limit ceiling"/>
              <TextBlock Grid.Column="1" x:Name="TxtMicLimiter" Style="{StaticResource Meta}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionHead}" Text="Separate app tracks"/>
            <CheckBox x:Name="ChkAppTracks" Content="Separate track for each app playing sound"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="Tracks can be switched off in the editor. Clips still play everything together."/>
            <TextBlock x:Name="AppTracksCost" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Foreground="{DynamicResource AccentText}"/>
            <CheckBox x:Name="ChkElevatedApps" Margin="0,10,0,0"
                      Content="Own tracks for apps running as administrator"
                      Tag="administrator admin elevated uac game mod launcher unknown track helper"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="Windows won't let Persocord hear these apps directly (some games and mod launchers run this way). Windows asks once per session, only when one plays sound. Off, or if you say no: their sound stays in All PC audio, and the editor offers it as an Unknown track."/>

            <Expander Style="{StaticResource Fold}" Header="Advanced">
              <StackPanel>
                <Label Content="Separate app tracks for up to"/>
                <ComboBox x:Name="CmbMaxApps" Width="160" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Extra apps share an 'Other apps' track. Each browser counts as one app."/>
                <Label Content="Audio bitrate (kbps)" Margin="0,14,0,0"/>
                <ComboBox x:Name="CmbAudioBitrate" Width="120" HorizontalAlignment="Left"/>

                <Button Content="Rescan devices" Click="Rescan_Click"
                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
              </StackPanel>
            </Expander>


          </StackPanel>
        </ScrollViewer>
      </TabItem>



      <!-- ============ recording ============ -->
      <TabItem Header="Recording">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Recording" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Text="Recording an area of the screen, from picking it to the finished clip."/>

            <Label Content="When you open Persocord from its icon"/>
            <ComboBox x:Name="CmbOpenAction" Width="320" HorizontalAlignment="Left">
              <ComboBoxItem Content="Go straight to picking an area"/>
              <ComboBoxItem Content="Open the clip list"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="While recording, opening it saves the clip."/>

            <Expander Style="{StaticResource Fold}" Header="Quality" IsExpanded="True">
              <StackPanel>
                <CheckBox x:Name="ChkRecordLikeReplay" Content="Same quality as the replay"
                          Checked="RecordLikeReplay_Changed" Unchecked="RecordLikeReplay_Changed"
                          Tag="quality same replay format encoder resolution frame rate fps bitrate"/>
                <TextBlock x:Name="RecordLikeNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                <StackPanel x:Name="RecordQualityOwn" Margin="0,8,0,0">
                  <Label Content="Video format"/>
                  <ComboBox x:Name="CmbRecordCodec" Width="260" HorizontalAlignment="Left" SelectionChanged="RecordEstimate_Changed">
                    <ComboBoxItem Content="H.264 (plays everywhere)"/>
                    <ComboBoxItem Content="HEVC (smaller)"/>
                    <ComboBoxItem Content="AV1 (smallest)"/>
                  </ComboBox>
                  <Label Content="Encoder" Margin="0,12,0,0"/>
                  <ComboBox x:Name="CmbEncoder" Width="320" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="EncoderNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <Label Content="Resolution" Margin="0,12,0,0"/>
                  <ComboBox x:Name="CmbResolution" Width="220" HorizontalAlignment="Left" SelectionChanged="RecordEstimate_Changed">
                    <ComboBoxItem Content="The area's own size"/>
                    <ComboBoxItem Content="1440p"/>
                    <ComboBoxItem Content="1080p"/>
                    <ComboBoxItem Content="720p"/>
                  </ComboBox>
                  <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Text="Areas are only ever made smaller, never stretched."/>
                  <Label Content="Frame rate" Margin="0,12,0,0"/>
                  <ComboBox x:Name="CmbFps" Width="220" HorizontalAlignment="Left" SelectionChanged="RecordEstimate_Changed"/>
                  <TextBlock x:Name="FpsNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <Label Content="Size is set by" Margin="0,12,0,0"/>
                  <ComboBox x:Name="CmbRecordRate" Width="320" HorizontalAlignment="Left" SelectionChanged="RecordRate_Changed"
                            Tag="bitrate quality crf cq size">
                    <ComboBoxItem Content="A quality level (size varies with the action)"/>
                    <ComboBoxItem Content="A fixed bitrate (size you can predict)"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel x:Name="RecordQualityPanel" Margin="0,0,24,0">
                      <Label Content="Quality level (lower is sharper)"/>
                      <TextBox x:Name="TxtCrf" Width="90" HorizontalAlignment="Left" TextChanged="RecordEstimate_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="RecordBitratePanel">
                      <Label Content="Bitrate (Mbps)"/>
                      <TextBox x:Name="TxtBitrate" Width="90" HorizontalAlignment="Left" TextChanged="RecordEstimate_Changed"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="RecordEstimate" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,12,0,0"
                             Foreground="{DynamicResource AccentText}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="The editor uses the quality level too when it has to re-encode."/>
              </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource SectionHead}" Text="What appears in the clip"/>
            <CheckBox x:Name="ChkCursor" Content="Show the mouse cursor" Margin="0,2,0,10"/>
            <CheckBox x:Name="ChkClicks" Content="Draw a ring where I click" Margin="0,0,0,6"/>
            <Grid Margin="26,4,0,4" Width="320" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ring size" VerticalAlignment="Center"
                         Foreground="{DynamicResource Muted}" FontSize="12.5"/>
              <Slider Grid.Column="1" x:Name="SldClickSize" Minimum="16" Maximum="120"
                      Margin="10,0,10,0" VerticalAlignment="Center"
                      IsSnapToTickEnabled="True" TickFrequency="2"/>
              <TextBlock Grid.Column="2" x:Name="ClickSizeText" Style="{StaticResource Meta}"
                         VerticalAlignment="Center" Width="40"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionHead}" Text="While recording"/>
            <CheckBox x:Name="ChkBar" Content="Show the control bar"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,0,0,6"
                       Text="Sits outside the recorded area. Drag it anywhere."/>
            <CheckBox x:Name="ChkBorder" Content="Outline the area being captured"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,0,0,0"
                       Text="The outline, ring and bar colours are under Customization."/>
            <Label Content="Countdown before recording starts" Margin="0,14,0,0"/>
            <ComboBox x:Name="CmbCountdown" Width="160" HorizontalAlignment="Left"/>
            <CheckBox x:Name="ChkRememberRegion" Margin="0,12,0,0"
                      Content="Remember my last area (Space reuses it)"/>

            <TextBlock Style="{StaticResource SectionHead}" Text="After recording"/>
            <CheckBox x:Name="ChkShowLibrary"
                      Content="Open the clip list after each recording"/>

            <Expander Style="{StaticResource Fold}" Header="Length">
              <StackPanel>
                <Label Content="Stop automatically after (seconds, 0 = never)"/>
                <TextBox x:Name="TxtMaxLength" Width="80" HorizontalAlignment="Left"/>
                <Label Content="Turn the timer red after (seconds, 0 = never)" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtWarnAt" Width="80" HorizontalAlignment="Left"/>
              </StackPanel>
            </Expander>
            <Expander Style="{StaticResource Fold}" Header="Clip names">
              <StackPanel>
                <Label Content="Pattern"/>
                <TextBox x:Name="TxtTitleTemplate"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Available: {app} {date} {time} {w} {h} {fps}"/>
              </StackPanel>
            </Expander>
            <Expander Style="{StaticResource Fold}" Header="Advanced">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                           Text="Only needed if recordings won't start or look wrong."/>
                <Label Content="Capture method"/>
                <ComboBox x:Name="CmbBackend" Width="320" HorizontalAlignment="Left"
                          Tag="capture method desktop duplication gdi ddagrab">
                  <ComboBoxItem Content="Pick the fastest that works"/>
                  <ComboBoxItem Content="Desktop duplication (fast, GPU)"/>
                  <ComboBoxItem Content="GDI (slower, works everywhere)"/>
                </ComboBox>
                <Label Content="NVENC preset" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbNvencPreset" Width="220" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="NVIDIA only, for area recordings with their own quality."/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ replay ============ -->
      <TabItem Header="Replay">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Replay" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Text="Keeps the last moments of your screen, ready to save with a hotkey."/>

            <CheckBox x:Name="ChkReplayOn" Content="Keep a replay running (starts with Persocord)"/>
            <Label Content="When it runs" Margin="0,12,0,0"/>
            <ComboBox x:Name="CmbReplayWhen" Width="260" HorizontalAlignment="Left"
                      Tag="games only game detected medal shadowplay when running">
              <ComboBoxItem Content="Always"/>
              <ComboBoxItem Content="Only while a game runs"/>
            </ComboBox>
            <TextBlock x:Name="ReplayWhenNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Stops 5 minutes after the game closes. Some games aren't recognised: add them from the tray menu while the game is open."/>
            <TextBlock Style="{StaticResource Meta}" Margin="0,10,0,4" Text="Your games"/>
            <StackPanel x:Name="MyGamesList" Margin="0,0,0,4" Tag="your games added count as a game"/>

            <TextBlock Style="{StaticResource SectionHead}" Text="What to keep"/>
            <Label Content="Length"/>
            <ComboBox x:Name="CmbReplayLength" Width="220" HorizontalAlignment="Left" SelectionChanged="ReplayEstimate_Changed"/>
            <StackPanel x:Name="ReplayCustomRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
              <TextBox x:Name="TxtReplayCustom" Width="80" TextChanged="ReplayEstimate_Changed"/>
              <TextBlock Text="seconds (5–3600)" VerticalAlignment="Center" Margin="10,0,0,0"
                         Foreground="{DynamicResource Muted}" FontSize="12.5"/>
            </StackPanel>
            <CheckBox x:Name="ChkReplayStartOver" Margin="0,10,0,0" Content="Start over after saving"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="The next save only has what happened since the last one."/>
            <Label Content="Screen" Margin="0,12,0,0"/>
            <ComboBox x:Name="CmbReplayScreen" Width="320" HorizontalAlignment="Left" SelectionChanged="ReplayEstimate_Changed"/>
            <CheckBox x:Name="ChkReplayCursor" Margin="0,12,0,0" Content="Show the mouse pointer"/>
            <CheckBox x:Name="ChkReplayLight" Margin="0,12,0,0" Content="Lighter on the CPU"
                      Tag="cpu lag stutter light performance low end weak pc fps"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Text="For 6-core PCs and below, or if games stutter while the replay runs. Keeps PC audio and the mic but not a track per app, encodes sound more lightly, and lets games go first. Off, nothing is held back."/>
            <TextBlock x:Name="ReplayLightCost" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                       Foreground="{DynamicResource AccentText}"/>

            <Border x:Name="ReplayVramCard" Margin="0,14,0,0" Padding="14,11" CornerRadius="8"
                    Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    Tag="cost usage vram video memory cpu ram memory disk gpu encoder performance resources">
              <StackPanel>
                <TextBlock Text="What the replay uses" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Estimated for the settings on this page, before saving. Each list also shows what its other choices would change."/>
                <Grid x:Name="ReplayCostRows" Margin="0,10,0,0"/>
                <TextBlock x:Name="ReplayVram" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="ReplayVramSizes" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="ReplayVramWarn" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brick}" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <Expander Style="{StaticResource Fold}" Header="Quality">
              <StackPanel>
                <Label Content="Video format"/>
                <ComboBox x:Name="CmbReplayCodec" Width="260" HorizontalAlignment="Left" SelectionChanged="ReplayCodec_Changed"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="H.264 plays everywhere. HEVC is smaller; AV1 is smallest."/>
                <Label Content="Encoder" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="CmbReplayEncoder" Width="320" HorizontalAlignment="Left" SelectionChanged="ReplayEstimate_Changed"/>
                  <Button Content="Check encoders again" Margin="10,0,0,0" Click="RecheckEncoders_Click"
                          ToolTip="Tests every encoder again, for example after updating a graphics driver"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Use your graphics card's own encoder (NVENC on NVIDIA). CPU encoding is heavy while gaming."/>
                <Label Content="Resolution" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbReplayRes" Width="220" HorizontalAlignment="Left" SelectionChanged="ReplayEstimate_Changed"/>
                <Label Content="Frame rate" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbReplayFps" Width="220" HorizontalAlignment="Left" SelectionChanged="ReplayEstimate_Changed"/>
                <Label Content="Size is set by" Margin="0,12,0,0"/>
                <ComboBox x:Name="CmbReplayRate" Width="320" HorizontalAlignment="Left" SelectionChanged="ReplayRate_Changed">
                  <ComboBoxItem Content="A quality level (size varies with the action)"/>
                  <ComboBoxItem Content="A fixed bitrate (size you can predict)"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <StackPanel x:Name="QualityPanel" Margin="0,0,24,0">
                    <Label Content="Quality level (lower is sharper)"/>
                    <TextBox x:Name="TxtReplayQuality" Width="90" HorizontalAlignment="Left" TextChanged="ReplayEstimate_Changed"/>
                  </StackPanel>
                  <StackPanel x:Name="BitratePanel">
                    <Label Content="Bitrate (Mbps)"/>
                    <TextBox x:Name="TxtReplayBitrate" Width="90" HorizontalAlignment="Left" TextChanged="ReplayEstimate_Changed"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ReplayEstimate" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource AccentText}"/>


              </StackPanel>
            </Expander>

            <Expander Style="{StaticResource Fold}" Header="Sound tracks">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                           Text="Each is kept as its own track for editing."/>
                <CheckBox x:Name="ChkRtPc" Content="PC audio"/>
                <CheckBox x:Name="ChkRtMic" Margin="0,8,0,0" Content="Microphone"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                           Text="Windows shows the mic as in use while this is on."/>
                <TextBlock x:Name="ReplayTracksCost" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource AccentText}"/>
              </StackPanel>
            </Expander>

            <Expander Style="{StaticResource Fold}" Header="Safety limits">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="What recording may use at most."/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Recording always gives way to games on the CPU."/>
                <CheckBox x:Name="ChkSafeCpuHard" Content="Strict CPU limit (not recommended)"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                           Text="Can make replays choppy."/>
                <Label Content="Strict limit (% of CPU)" Margin="22,8,0,0"/>
                <TextBox x:Name="TxtSafeCpu" Width="90" HorizontalAlignment="Left" Margin="22,0,0,0"/>
                <Label Content="Memory limit (MB)" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtSafeRam" Width="90" HorizontalAlignment="Left"/>
                <Label Content="Video memory limit (MB)" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtSafeVram" Width="90" HorizontalAlignment="Left" TextChanged="ReplayEstimate_Changed"/>
                <TextBlock x:Name="SafeVramNote" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <CheckBox x:Name="ChkSafeGpu" Margin="0,12,0,0" Content="Give games priority when video memory is nearly full"/>
                <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                  <TextBox x:Name="TxtVramFull" Width="60"/>
                  <TextBlock Text="% counts as nearly full" VerticalAlignment="Center"
                             Margin="10,0,0,0" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                </StackPanel>
                <TextBlock x:Name="SafetyTypical" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Typical use: 2–5% CPU, 150–300 MB memory, 100–250 MB video memory."/>
              </StackPanel>
            </Expander>

            <Expander Style="{StaticResource Fold}" Header="Advanced">
              <StackPanel>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                           Text="Only needed if something looks or sounds off."/>
                <Label Content="Sound sync (ms)"/>
                <TextBox x:Name="TxtReplaySync" Width="90" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="If sound runs behind the picture. Higher moves sound earlier."/>
                <CheckBox x:Name="ChkReplayFullRange" Margin="0,14,0,0" Content="Full-range colour for resized replays"/>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,2,0,0"
                           Text="Switch this if resized replays look washed out or too dark."/>
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>
      </TabItem>


      <TabItem Header="Hotkeys">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Click a box, then press the keys. Esc cancels, Backspace clears."/>

            <Label Content="Select an area and start recording"/>
            <v:HotkeyBox x:Name="TxtHkRegion" Width="220" HorizontalAlignment="Left"/>

            <Label Content="Pause or resume" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkPause" Width="220" HorizontalAlignment="Left"/>

            <Label Content="Finish recording" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkStop" Width="220" HorizontalAlignment="Left"/>

            <Label Content="Cancel and throw it away" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkCancel" Width="220" HorizontalAlignment="Left"/>

            <Label Content="Save replay" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkReplay" Width="220" HorizontalAlignment="Left"/>
            <Label Content="Save replay, setup 2" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal">
              <v:HotkeyBox x:Name="TxtHkReplay2" Width="220"/>
              <TextBox x:Name="TxtReplaySec2" Width="70" Margin="10,0,0,0"/>
              <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
            </StackPanel>
            <Label Content="Save replay, setup 3" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal">
              <v:HotkeyBox x:Name="TxtHkReplay3" Width="220"/>
              <TextBox x:Name="TxtReplaySec3" Width="70" Margin="10,0,0,0"/>
              <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
            </StackPanel>

            <Label Content="Turn replay on or off" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkToggleReplay" Width="220" HorizontalAlignment="Left"/>

            <TextBlock x:Name="HotkeyNote" Style="{StaticResource Meta}" TextWrapping="Wrap"
                       Margin="0,14,0,0" Foreground="{DynamicResource AccentText}"/>

            <TextBlock Style="{StaticResource SectionHead}" Text="Editor"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Only while the editor is open. With a clip selected they work on that clip; with nothing selected, on every track."/>
            <Label Content="Split at the playhead"/>
            <v:HotkeyBox x:Name="TxtHkEdSplit" AllowPlain="True" Width="220" HorizontalAlignment="Left"/>
            <Label Content="Delete everything left of the playhead (the rest slides back)" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkEdLeft" AllowPlain="True" Width="220" HorizontalAlignment="Left"/>
            <Label Content="Delete everything right of the playhead" Margin="0,12,0,0"/>
            <v:HotkeyBox x:Name="TxtHkEdRight" AllowPlain="True" Width="220" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ about ============ -->
      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,28,24">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Image x:Name="AboutLogo" Width="64" Height="64" Margin="-4,0,14,0" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Persocord" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="AboutVersion" Style="{StaticResource Meta}" Margin="0,4,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Clip your screen, trim it, and get it into Discord in seconds."/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Re-setup" Click="RunSetup_Click" Margin="0,0,8,0"
                      Tag="setup re-setup onboarding tutorial welcome first run wizard"
                      ToolTip="The first-time setup again. It shows your current settings; only what you change there changes."/>
              <Button Content="GitHub page" Click="GitHub_Click" Style="{StaticResource Ghost}"
                      Tag="github source code releases download website"
                      ToolTip="Persocord's page: downloads, every version and the source"/>
            </WrapPanel>

            <Label Content="When a new version is out" Margin="0,18,0,0"/>
            <ComboBox x:Name="CmbUpdateMode" Width="320" HorizontalAlignment="Left"
                      Tag="update updates new version download install upgrade">
              <ComboBoxItem Content="Update installs it for me"/>
              <ComboBoxItem Content="Update opens the download page"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Persocord checks every time it starts. A new version shows as a bar on the clip list, never over a game."/>

            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="16,12,16,12"
                    Margin="0,22,0,0" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="CREDITS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13.5">
                  <Run Text="Vibecoded by "/><Run Text="dodorider" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/><Run Text=" + "/><Run Text="Claude" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="420"
                           Text="Designed by dodorider, built by Claude (Anthropic). Video by FFmpeg, playback by VLC, sound by NAudio."/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="16,12,16,14"
                    Margin="0,10,0,0" HorizontalAlignment="Left">
              <StackPanel MaxWidth="440">
                <TextBlock Text="LICENSE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13.5" Foreground="{DynamicResource Ink}">
                  <Run Text="© 2026 "/><Run Text="dodorider" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/><Run Text=" · PolyForm Noncommercial 1.0.0"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Free to use, change and share for anything non-commercial, as long as the credit stays with it. Selling it, or any other commercial use, needs permission: ask dodorider on Discord (ruined). Changed versions need their own name."/>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Read the license" Click="License_Click" Margin="0,0,8,0"/>
                  <Button Content="Third-party notices" Click="Notices_Click" Style="{StaticResource Ghost}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHead}" Text="Diagnostics"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                       Text="Checks everything and copies a report you can paste into a chat."/>
            <WrapPanel>
              <Button x:Name="DiagButton" Content="Create diagnostics report" Style="{StaticResource Primary}"
                      Click="Diagnostics_Click" Margin="0,0,8,8"/>
              <Button x:Name="DiagFolder" Content="Show report file" Click="DiagFolder_Click" Margin="0,0,8,8" Visibility="Collapsed"/>
            </WrapPanel>
            <TextBlock x:Name="DiagStatus" Style="{StaticResource Meta}" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}"/>

            <TextBlock Style="{StaticResource SectionHead}" Text="Your settings"/>
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,-4,0,10"
                       Text="Your clips are never touched. The look (colours and style) is separate: it has its own code, file and reset under Customization."/>
            <WrapPanel>
              <Button Content="Copy settings code" Click="CopySettingsCode_Click" Margin="0,0,8,8"
                      Tag="share code settings friend paste"/>
              <Button Content="Import a settings code…" Click="ImportSettingsCode_Click" Margin="0,0,8,8"/>
              <Button Content="Export settings…" Click="ExportSettings_Click" Margin="0,0,8,8"/>
              <Button Content="Import settings…" Click="ImportSettings_Click" Margin="0,0,8,8"/>
              <Button Content="Reset all settings…" Style="{StaticResource Danger}" Click="ResetSettings_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock x:Name="BackupStatus" Style="{StaticResource Meta}" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource Panel}" Padding="20,12,20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="SaveNote" Style="{StaticResource Meta}" VerticalAlignment="Center"
                   Margin="0,0,14,0"/>
        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button Style="{StaticResource Primary}" Content="Save changes" Click="Save_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
